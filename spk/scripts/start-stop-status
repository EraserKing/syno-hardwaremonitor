#!/bin/sh
# No daemon: snapshot.cgi collects on demand into tmpfs.
# This script only prepares and clears that cache.
set -u

SHM=${HARDWAREMONITOR_SHM:-/dev/shm/hardwaremonitor}
VAR=${SYNOPKG_PKGVAR:-/var/packages/hardwaremonitor/var}

case ${1:-} in
    start)
        mkdir -p "$SHM" 2>/dev/null || true
        rm -rf "$SHM/collect.lock" 2>/dev/null || true
        # Drop the previous daemon's snapshot and pid file.
        rm -f "$VAR/snapshot.json" "$VAR/state" "$VAR/collect.pid" \
              "$VAR/collect.log" 2>/dev/null || true
        exit 0
        ;;
    stop)
        rm -rf "$SHM" 2>/dev/null || true
        exit 0
        ;;
    status)
        exit 0
        ;;
    *)
        exit 1
        ;;
esac
